# Multi-stage build for pgEdge Postgres MCP CLI Client
# Stage 1: Build the Go binary
FROM golang:1.26.10-alpine AS builder

# Set working directory
WORKDIR /workspace

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build the CLI binary
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o pgedge-nla-cli ./cmd/pgedge-pg-mcp-cli

# Stage 2: Create minimal runtime image
# distroless/static holds only CA certificates, time zone data and a
# passwd file: no shell or package manager. The CLI is a static Go binary
# and needs nothing else at runtime.
FROM gcr.io/distroless/static-debian13

# Add labels for container metadata
LABEL name="pgedge-nla-cli" \
      vendor="pgEdge" \
      version="1.0" \
      summary="pgEdge NAtural LAnguage Agent CLI" \
      description="Command-line chat interface for pgEdge Natural Language Agent" \
      io.naturallanguageagent.cli.name="io.github.pgEdge/nla-cli"

# Create non-root user
USER 1001

# Set working directory
WORKDIR /app

# Copy the binary from builder
COPY --from=builder --chown=1001:1001 /workspace/pgedge-nla-cli /app/pgedge-nla-cli

# Set entrypoint
ENTRYPOINT ["/app/pgedge-nla-cli"]

# Default arguments (can be overridden)
CMD ["-mcp-mode", "http", "-mcp-url", "http://postgres-mcp:8080"]
