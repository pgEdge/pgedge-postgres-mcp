# Multi-stage build for pgEdge Postgres MCP Web Client
# Stage 1: Build the Vue.js application
FROM registry.access.redhat.com/ubi9/nodejs-24:latest AS builder

# Set working directory
WORKDIR /workspace

# Copy package files
COPY web/package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY web/ ./

# Build the application
RUN npm run build

# Stage 2: Serve with nginx
# nginx-unprivileged runs nginx as the non-root "nginx" user (UID 101)
# and the alpine-slim variant omits everything a static file server and
# reverse proxy does not need. It replaces UBI nginx, which carried a large
# backlog of CVEs with no fix available in packages this image never used.
# See https://hub.docker.com/r/nginxinc/nginx-unprivileged
FROM nginxinc/nginx-unprivileged:stable-alpine-slim

# Add labels for container metadata
LABEL name="pgedge-nla-web" \
      vendor="pgEdge" \
      version="1.2" \
      summary="pgEdge Natural Language Agent Web Client" \
      description="Web-based chat interface for pgEdge Natural Language Agent" \
      io.naturallanguageagent.web.name="io.github.pgEdge/nla-web"

# Apply available security patches
# Cache-bust: CACHE_DATE forces re-execution of apk upgrade on each CI build
ARG CACHE_DATE
USER root
RUN apk upgrade --no-cache

# Copy built application from builder
COPY --from=builder /workspace/dist /opt/app-root/src

# Copy nginx configuration with proper permissions
COPY --chmod=644 docker/nginx.conf /etc/nginx/nginx.conf

# Expose HTTP port
EXPOSE 8081

# Run as the base image's unprivileged "nginx" user. The UID is given
# numerically so Kubernetes can verify runAsNonRoot without a runAsUser.
USER 101

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
